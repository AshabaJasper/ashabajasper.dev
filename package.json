{
  "name": "ashabajasper-dev",
  "version": "0.1.0",
  "private": true,
  "description": "Portfolio, blog and admin for Ashaba Joshua Jasper, served by one Next.js app with host-based routing.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "prebuild": "tsx scripts/check-content.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:check": "tsx scripts/check-content.ts",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "images": "node scripts/optimize-images.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "logos": "node scripts/generate-tech-logos.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "feed": "^6.0.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.52.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "15.5.27",
    "next-auth": "5.0.0-beta.32",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "simple-icons": "16.34.0",
    "smtp-mailer": "npm:nodemailer@10.0.16",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.27",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "sharp": "$sharp",
    "postcss": "8.5.29"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true,
    "sharp@0.35.5": true,
    "prisma@6.19.3": true
  }
}
