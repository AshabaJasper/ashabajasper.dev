// Admin data for ashabajasper.dev: the single owner, sign-in safety, contact
// messages from the portfolio and comments on the blog. Posts themselves are
// MDX files in content/posts, not database rows.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The single owner. Created once through /setup, never by a seed with a stored password.
model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  /// bcrypt hash only. The PIN is never accepted without a trusted-device token.
  pinHash      String?
  pinLength    Int?
  pinSetAt     DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  devices      TrustedDevice[]
  auditLogs    AuditLog[]
}

/// A browser allowed to offer the PIN screen. The cookie holds the raw token; only its sha256 is stored.
model TrustedDevice {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String    @unique
  label          String
  failedPinCount Int       @default(0)
  lastUsedAt     DateTime?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String   @default("")
  entityId   String   @default("")
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
  SPAM
}

/// A message sent through the portfolio contact form.
model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String?
  body      String
  status    MessageStatus @default(NEW)
  /// HMAC of the sender IP with AUTH_SECRET, cleared after 30 days. Never the raw IP.
  ipHash    String?
  userAgent String?
  replyBody String?
  /// "smtp" when sent from the admin, "mailto" when sent from the owner's mail client.
  replyVia  String?
  repliedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([ipHash, createdAt])
}

enum CommentStatus {
  PENDING
  APPROVED
  SPAM
}

/// A reply on a blog post. Visitor comments wait for approval; owner replies are approved at once.
model Comment {
  id          String        @id @default(cuid())
  postSlug    String
  parentId    String?
  parent      Comment?      @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]     @relation("Replies")
  authorName  String
  /// Optional and never shown publicly.
  authorEmail String?
  body        String
  status      CommentStatus @default(PENDING)
  isOwner     Boolean       @default(false)
  ipHash      String?
  userAgent   String?
  approvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([postSlug, status, createdAt])
  @@index([status, createdAt])
  @@index([ipHash, createdAt])
}
