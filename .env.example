# ashabajasper.dev environment. Copy to .env for local development.
# Production values live in Coolify (runtime only, except the two NEXT_PUBLIC_ values).

# Database (production host is the compose service `db`)
DATABASE_URL="postgresql://ajdev:ajdev_dev_password@localhost:5435/ajdev?schema=public"
POSTGRES_USER="ajdev"
POSTGRES_PASSWORD=""
POSTGRES_DB="ajdev"

# Auth.js. Generate the secret with: openssl rand -base64 32
# AUTH_SECRET also keys the IP hashes and the contact/comment form tokens.
AUTH_SECRET=""
AUTH_URL="http://admin.localhost:3000"
AUTH_TRUST_HOST="true"

# All three origins derive from this: <root>, blog.<root>, admin.<root>.
# Production: ashabajasper.dev. Development: localhost:3000.
ROOT_DOMAIN="localhost:3000"

# One-time owner setup at admin.<root>/setup. Works only while no owner exists.
# Generate with: openssl rand -hex 24
SETUP_TOKEN=""
# Where new-message notifications go when SMTP is configured (falls back from MAIL_TO).
ADMIN_EMAIL=""

# Optional: send email replies and notifications from the admin.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
MAIL_TO=""

# Optional: a short Telegram ping on new messages and comments (never the message text).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Self-hosted Umami. Public values written into the HTML, so they are build-time variables.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

TZ="Africa/Kampala"
